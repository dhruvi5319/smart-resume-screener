# --- Summary generation ---
# Default: GPT-3.5 via OpenAI.
OPENAI_API_KEY=your-api-key-here

# Set to "true" to use the fine-tuned local Llama 3.2 3B model instead of GPT-3.5
# (no API cost). Requires HF_TOKEN to download the gated base model.
USE_LOCAL_MODEL=false
HF_TOKEN=your-hf-token-here
# Optional overrides:
# BASE_MODEL=meta-llama/Llama-3.2-3B-Instruct
# LORA_ADAPTER=dhruvi5319/llama-3.2-3b-resume-fit-summary